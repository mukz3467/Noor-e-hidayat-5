{
  "version": 8,
  "name": "Noor 3D Satellite HD",
  "light": {
    "anchor": "viewport",
    "color": "#fff8ee",
    "intensity": 0.48,
    "position": [1.15, 210, 35]
  },
  "sources": {
    "esri-world-imagery": {
      "type": "raster",
      "tiles": [
        "https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
      ],
      "tileSize": 256,
      "minzoom": 0,
      "maxzoom": 18,
      "attribution": "Esri, Maxar WorldView-3, Earthstar Geographics, and the GIS User Community"
    },
    "aws-terrarium-dem": {
      "type": "raster-dem",
      "tiles": [
        "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "maxzoom": 15,
      "encoding": "terrarium",
      "attribution": "Mapzen / AWS Terrain Tiles"
    },
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "noor-terrain-background",
      "type": "background",
      "paint": {
        "background-color": [
          "interpolate",
          ["linear"],
          ["zoom"],
          0, "#1D3329",
          16.5, "#233B30",
          17.2, "#F2EFE9",
          18.0, "#F5F2EC"
        ]
      }
    },
    {
      "id": "arch-landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "minzoom": 11,
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "residential", "#EAE5DB",
          "commercial", "#F2E2D9",
          "retail", "#F5E2D3",
          "industrial", "#E3E1DB",
          "school", "#F5EBD0",
          "university", "#F5EBD0",
          "college", "#F5EBD0",
          "hospital", "#F8DFDF",
          "cemetery", "#D3E4CE",
          "pitch", "#BBE3B5",
          "stadium", "#C6E6BE",
          "#ECE8DF"
        ],
        "fill-opacity": 0.96
      }
    },
    {
      "id": "arch-landcover-green",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 9,
      "paint": {
        "fill-color": [
          "match",
          ["get", "class"],
          "wood", "#A7D49E",
          "grass", "#C4E5BC",
          "farmland", "#E4ECD6",
          "sand", "#EFE5C8",
          "wetland", "#B7DFD6",
