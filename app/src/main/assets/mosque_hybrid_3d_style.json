        "fill-extrusion-height": [
          "interpolate",
          ["linear"],
          ["zoom"],
          14.5, 0,
          15.4, ["coalesce", ["get", "render_height"], ["get", "height"], 9]
        ],
        "fill-extrusion-base": [
          "coalesce",
          ["get", "render_min_height"],
          ["get", "min_height"],
          0
        ],
        "fill-extrusion-vertical-gradient": true
      }
